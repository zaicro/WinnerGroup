<?xml version="1.0" encoding="utf-8" ?>
<log4net>
	<root>
		<level value="ALL" />
		<appender-ref ref="RollingFileAppender" />
	</root>

	<appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
		<file value="C:/_Logs/API/logfile.log" />
		<appendToFile value="true" />
		<rollingStyle value="Date" />
		<datePattern value="yyyyMMdd" />
		<maxSizeRollBackups value="10" />
		<maximumFileSize value="10MB" />
		<staticLogFileName value="false" />
		<layout type="log4net.Layout.PatternLayout,log4net">
			<param name="ConversionPattern" value="%date [%thread] ProductName=ERP ApplicationType=API ApplicationName=HR Level=%level ClassName=%logger MethodName=%property{MethodName} Message=%m%n" />
		</layout>
	</appender>

</log4net>
