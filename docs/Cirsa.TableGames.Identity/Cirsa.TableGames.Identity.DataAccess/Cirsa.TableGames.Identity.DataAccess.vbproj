<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cirsa.TableGames.Identity.DataAccess</RootNamespace>
    <AssemblyName>Cirsa.TableGames.Identity.DataAccess</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Company>Cirsa</Company>
    <Product>Cirsa.TableGames.Identity</Product>
    <Description>Data access and persistence for table game identity management.</Description>
    <Version>0.1.0</Version>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.5.2" />
  </ItemGroup>

</Project>
