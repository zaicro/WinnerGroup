<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Cirsa.WebApi2.Authentication</RootNamespace>
    <AssemblyName>Cirsa.WebApi2.Authentication</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Company>Cirsa</Company>
    <Product>Cirsa.WebApi2.Authentication</Product>
    <Description>API key and JWT authentication for ASP.NET Web API 2 applications.</Description>
    <Version>0.1.0</Version>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <LangVersion>latest</LangVersion>
    <!-- NuGet package -->
    <IsPackable>true</IsPackable>
    <PackageId>Cirsa.WebApi2.Authentication</PackageId>
    <Authors>Cirsa</Authors>
    <PackageTags>authentication;webapi2;apikey;jwt</PackageTags>
    <PackageOutputPath>bin\packages\$(Configuration)\</PackageOutputPath>
    <!-- Generate the package automatically for Release builds -->
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.WebApi.Core" Version="5.2.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>  
</Project>
