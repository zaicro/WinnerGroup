<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Cirsa.WebApi2.Swagger</RootNamespace>
    <AssemblyName>Cirsa.WebApi2.Swagger</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Company>Cirsa</Company>
    <Product>Cirsa.WebApi2.Swagger</Product>
    <Description>API key and JWT Swagger for ASP.NET Web API 2 applications.</Description>
    <Version>0.1.0</Version>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <LangVersion>latest</LangVersion>
    <!-- NuGet package -->
    <IsPackable>true</IsPackable>
    <PackageId>Cirsa.WebApi2.Swagger</PackageId>
    <Authors>Cirsa</Authors>
    <PackageTags>Swagger;webapi2;apikey;jwt</PackageTags>
    <PackageOutputPath>bin\packages\$(Configuration)\</PackageOutputPath>
    <!-- Generate the package automatically for Release builds -->
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.WebApi.Core" Version="5.2.9" />
    <PackageReference Include="Swashbuckle.Core" Version="5.6.0" />
  </ItemGroup>
</Project>
