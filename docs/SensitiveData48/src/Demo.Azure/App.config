<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <!-- Solo identificadores y opciones públicas. Ninguna credencial. -->
  <appSettings>
    <add key="Environment" value="Development" />
    <add key="AzureAuthentication" value="AzureCli" />
    <add key="KeyVaultUri" value="https://REEMPLAZAR.vault.azure.net/" />
    <add key="ManagedIdentityClientId" value="" />
    <add key="TenantId" value="" />
    <add key="ClientId" value="" />
    <add key="CertificateThumbprint" value="" />
    <add key="JwtIssuer" value="SensitiveData48" />
    <add key="JwtAudience" value="SensitiveData48.Demo" />
    <add key="JwtCurrentKid" value="v1" />
    <add key="JwtAcceptedKids" value="v1" />
    <add key="UseSqlSecret" value="false" />
  </appSettings>
</configuration>
