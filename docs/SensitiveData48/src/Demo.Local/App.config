<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <!-- Solo opciones públicas. Los secretos no van aquí. -->
  <appSettings>
    <add key="JwtIssuer" value="SensitiveData48" />
    <add key="JwtAudience" value="SensitiveData48.Demo" />
    <add key="JwtCurrentKid" value="v1" />
    <add key="JwtAcceptedKids" value="v1" />
  </appSettings>
  <connectionStrings>
    <add name="Primary" connectionString="Server=localhost;Database=Example;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;Persist Security Info=False" providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
