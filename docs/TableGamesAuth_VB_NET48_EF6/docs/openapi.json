            "description": "Conflicto o restricción"
          },
          "413": {
            "description": "Cuerpo demasiado grande"
          },
          "429": {
            "description": "Límite de peticiones"
          },
          "500": {
            "description": "Error interno"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "security": [
          {
            "ApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResult"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida"
          },
          "401": {
            "description": "Credenciales inválidas"
          },
          "403": {
            "description": "Requiere SystemAdmin"
          },
          "404": {
            "description": "No encontrado"
          },
          "409": {
            "description": "Conflicto o restricción"
          },
          "413": {
            "description": "Cuerpo demasiado grande"
          },
          "429": {
            "description": "Límite de peticiones"
          },
          "500": {
            "description": "Error interno"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "responses": {
          "200": {
            "description": "Usuario, rol y aplicación de la sesión"
          },
          "401": {
            "description": "Sesión inválida"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      },
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RoleInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "version": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AppInput": {
        "type": "object",
        "required": [
          "name",
          "code"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$",
            "minLength": 2,
            "maxLength": 60
          },
          "isActive": {
            "type": "boolean",
            "default": true
          },
          "version": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UserInput": {
        "type": "object",
        "required": [
          "userName",
          "roleId"
        ],
        "description": "POST requiere Password o PasswordHash; PUT puede omitir ambos. Solo SystemAdmin. version obligatoria en PUT.",
        "properties": {
          "userName": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9._@-]+$"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          },
          "passwordHash": {
            "type": "string",
            "maxLength": 512,
            "writeOnly": true
          },
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "isActive": {
            "type": "boolean",
            "default": true
          },
          "version": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UserAppInput": {
        "type": "object",
        "required": [
          "userId",
          "appId"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "appId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": [
          "userName",
          "password",
          "appId"
        ],
        "properties": {
          "userName": {
            "type": "string",
            "maxLength": 80
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "writeOnly": true
          },
          "appId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "LoginResult": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        }
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "normalizedName": {
            "type": "string"
          }
        }
      },
      "App": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "string",
            "format": "uuid"
          },
          "userName": {
            "type": "string"
          },
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "UserApp": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "appId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
