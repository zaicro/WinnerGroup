<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cirsa.WebApi2.Extensions</RootNamespace>
    <AssemblyName>Cirsa.WebApi2.Extensions</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Company>Cirsa</Company>
    <Product>Cirsa.WebApi2.Extensions</Product>
    <Description>API key and JWT authentication, token issuance, and Swagger documentation extensions for ASP.NET Web API 2.</Description>
    <Version>0.1.1</Version>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <LangVersion>latest</LangVersion>
    <OptionInfer>On</OptionInfer>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;examples/**</DefaultItemExcludes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- NuGet package -->
    <IsPackable>true</IsPackable>
    <PackageId>Cirsa.WebApi2.Extensions</PackageId>
    <Authors>Cirsa</Authors>
    <PackageTags>authentication;webapi2;apikey;jwt;Swagger</PackageTags>
    <PackageOutputPath>bin\packages\$(Configuration)\</PackageOutputPath>
    <!-- Generate the package automatically for Release builds -->
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.WebApi.Core" Version="5.2.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="Swashbuckle.Core" Version="5.6.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <EmbeddedResource Include="Swagger\Assets\authorization.js" LogicalName="Cirsa.WebApi2.Extensions.Swagger.Assets.authorization.js" />
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
